# =============================================================================
# Bengali AI Learning Platform — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # Settings → API → service_role key
SUPABASE_JWT_SECRET=your-jwt-secret  # Settings → API → JWT Secret

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (fallback) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=exam-answers
R2_PUBLIC_URL=                       # optional, leave blank if using signed URLs only

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development              # development | production
CORS_ORIGINS=http://localhost:5173   # comma-separated, add your Cloudflare Pages URL in prod
DAILY_EXAM_LIMIT=10
INR_PER_USD=84.0
IMAGE_EXPIRY_SECONDS=3600            # 1 hour signed URL validity
